# FIRETRACK environment configuration
# Copy this file to ".env" and fill in what you need. Everything is optional:
# the application runs with no configuration at all.

# Free, instantly issued from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Enables the historical backfill and the "FIRMS key configured" badge.
FIRMS_MAP_KEY=

# Where the SQLite database and raw downloads live (default: ./data)
# FIRETRACK_DATA_DIR=./data

# Server bind address (default: 127.0.0.1:8000)
# FIRETRACK_HOST=127.0.0.1
# FIRETRACK_PORT=8000

# Common analysis grid in degrees (default: 0.25)
# FIRETRACK_GRID_DEG=0.25

# By default a year must be fully covered by the record to enter a trend or a
# median, so a year that is still in progress is not compared with complete
# years. Set to 0 to count any period that clears the 80% coverage gate.
# FIRETRACK_REQUIRE_FULL_PERIOD=0
